{
  "name": "time2fest-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "dev:test": "cross-env NEXT_PUBLIC_ENV=test next dev",
    "prebuild": "node scripts/sync_tokens.mjs --check && node scripts/sync_yt_loader.mjs",
    "build": "next build",
    "build:test": "cross-env NEXT_PUBLIC_ENV=test next build",
    "prebuild:demo": "node scripts/sync_tokens.mjs --check && node scripts/sync_yt_loader.mjs",
    "build:demo": "cross-env NEXT_PUBLIC_ENV=test NEXT_PUBLIC_DEMO=1 NEXT_DIST_DIR=out-demo next build",
    "build:prelaunch": "node scripts/prelaunch/build.mjs",
    "build:prelaunch:domain": "node scripts/prelaunch/build.mjs --index",
    "check:prelaunch": "node scripts/prelaunch/check.mjs out-prelaunch",
    "serve:prelaunch": "node scripts/prelaunch/serve.mjs out-prelaunch",
    "dev:prelaunch": "cross-env NEXT_PUBLIC_PRELAUNCH=1 NEXT_DIST_DIR=.next-prelaunch-dev next dev",
    "data:prelaunch": "node scripts/prelaunch/gen-data.mjs",
    "dev:demo": "cross-env NEXT_PUBLIC_ENV=test NEXT_PUBLIC_DEMO=1 NEXT_DIST_DIR=.next-demo next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "data:schedule": "python -X utf8 scripts/build_schedule.py",
    "data:streams:check": "python -X utf8 scripts/check_streams.py",
    "sync:tokens": "node scripts/sync_tokens.mjs",
    "sync:yt": "node scripts/sync_yt_loader.mjs",
    "stack": "node server/scripts/stack.mjs all",
    "stack:up": "node server/scripts/stack.mjs up",
    "stack:down": "node server/scripts/stack.mjs down",
    "stack:smoke": "node server/scripts/stack.mjs smoke",
    "db:create": "node server/scripts/stack.mjs db-create",
    "build:int": "cross-env NEXT_PUBLIC_ENV=test NEXT_PUBLIC_API_MODE=http NEXT_DIST_DIR=out-int next build",
    "serve:int": "node server/scripts/serve-int.mjs",
    "contracts:run": "node scripts/contract-run.mjs",
    "build:edge:test": "cross-env NEXT_PUBLIC_ENV=test NEXT_PUBLIC_API_MODE=http NEXT_DIST_DIR=out-edge-test next build",
    "build:edge:rehearsal": "cross-env NEXT_PUBLIC_SITE_CLASS=rehearsal NEXT_PUBLIC_ENV=test NEXT_PUBLIC_API_MODE=http NEXT_PUBLIC_REALTIME_URL=wss://rt-rehearsal.time2fest.com/connection/websocket NEXT_DIST_DIR=out-edge-rehearsal next build",
    "edge:deploy:test": "pnpm --dir workers/edge deploy:test",
    "edge:tunnel:up": "docker compose -p t2f-edge -f infra/cloudflare/cloudflared/compose.yml up -d",
    "edge:tunnel:down": "docker compose -p t2f-edge -f infra/cloudflare/cloudflared/compose.yml down",
    "infra:cf": "node infra/cloudflare/cf.mjs",
    "deploy:env": "node infra/ops/ops.mjs deploy",
    "rollback:env": "node infra/ops/ops.mjs rollback",
    "node:bootstrap": "node infra/ops/ops.mjs bootstrap",
    "edge:secret": "node infra/ops/ops.mjs edge-secret",
    "edge:move-domain": "node infra/ops/ops.mjs move-domain",
    "capacity": "node infra/ops/ops.mjs capacity"
  },
  "dependencies": {
    "@time2fest/contracts": "workspace:*",
    "@time2fest/rules": "workspace:*",
    "centrifuge": "5.8.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261011.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/nextjs": "10.6.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/d3-geo": "3.1.1",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "circle-flags": "2.8.3",
    "cross-env": "10.1.0",
    "d3-geo": "3.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.13.0",
    "jsdom": "28.1.0",
    "mapshaper": "0.7.83",
    "pngjs": "7.0.0",
    "postcss": "8.5.31",
    "postcss-pxtorem": "6.1.0",
    "prettier": "3.9.10",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
