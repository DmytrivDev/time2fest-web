{
  "name": "@time2fest/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=2",
    "test:int": "node scripts/lock.mjs --mode shared -- npx vitest run -c vitest.integration.config.ts --maxWorkers=1",
    "test:int:exclusive": "cross-env T2F_EXCLUSIVE=1 node scripts/lock.mjs --mode exclusive -- npx vitest run -c vitest.integration.config.ts --maxWorkers=1",
    "test:stack": "node scripts/lock.mjs --mode shared -- npx vitest run -c vitest.stack.config.ts --maxWorkers=1",
    "test:e2e": "playwright test --workers=2",
    "payload": "payload",
    "migrate": "payload migrate",
    "migrate:status": "payload migrate:status",
    "migrate:down": "payload migrate:down",
    "migrate:create": "payload migrate:create",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "schema:check": "node scripts/verify-schema.mjs",
    "seed": "tsx src/seed/cli.ts",
    "env:check": "tsx src/platform/env.check.ts",
    "import": "tsx src/cli/import.ts",
    "export": "tsx src/cli/export.ts",
    "owner:create": "tsx src/cli/createOwner.ts",
    "serve": "node scripts/stack.mjs serve",
    "build": "next build",
    "start": "node scripts/stack.mjs start",
    "start:prod": "next build && node scripts/stack.mjs start"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@time2fest/contracts": "workspace:*",
    "graphql": "16.15.0",
    "ioredis": "5.11.1",
    "jose": "5.10.0",
    "next": "16.4.5",
    "payload": "3.91.0",
    "pg": "8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@types/node": "22.19.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "centrifuge": "5.8.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.3"
  }
}
