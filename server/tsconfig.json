{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@payload-config": ["./src/payload.config.ts"] }
  },
  "include": ["next-env.d.ts", "src/**/*", "test/**/*", "scripts/**/*.mjs", "*.config.ts", "*.config.mjs", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "graphify-out"]
}
