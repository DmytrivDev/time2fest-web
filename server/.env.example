# Names only, no values. `pnpm db:create` writes server/.env.local (gitignored).
T2F_ENV=
T2F_TEST_DOORS=
T2F_SLOT=
T2F_SLUG=
T2F_SERVER_PORT=
T2F_HOST=
T2F_COMMIT=
T2F_WEB_PORT=
T2F_LOCK_DIR=
T2F_ALLOWED_ORIGINS=
DATABASE_URI=
REDIS_URL=
T2F_REDIS_PREFIX=
T2F_CENTRIFUGO_URL=
T2F_CENTRIFUGO_PREFIX=
SMTP_HOST=
SMTP_PORT=
PAYLOAD_SECRET=
PAYPRO_MODE=
T2F_EDGE_SECRET=
T2F_EDGE_SECRET_PREVIOUS=
T2F_CENTRIFUGO_TOKEN_SECRET=
T2F_CENTRIFUGO_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
T2F_AI_ANTHROPIC_URL=
T2F_AI_ANTHROPIC_MODEL=
T2F_AI_ANTHROPIC_VERSION=
T2F_AI_ANTHROPIC_PRICE_INPUT=
T2F_AI_ANTHROPIC_PRICE_OUTPUT=
T2F_AI_ANTHROPIC_PRICE_CACHE_READ=
T2F_AI_ANTHROPIC_PRICE_CACHE_WRITE=
T2F_AI_DEEPSEEK_URL=
T2F_AI_DEEPSEEK_MODEL=
T2F_AI_DEEPSEEK_PRICE_CACHE_HIT=
T2F_AI_DEEPSEEK_PRICE_CACHE_MISS=
T2F_AI_DEEPSEEK_PRICE_OUTPUT=
# User AI calls a minute per provider for the whole account (defaults 3400 / 1000); each server process uses floor(budget / T2F_AI_PROCESSES).
T2F_AI_ANTHROPIC_RPM=
T2F_AI_DEEPSEEK_RPM=
# Number of server processes sharing the AI accounts, positive integer (default 1).
T2F_AI_PROCESSES=
# Share of each AI spend ceiling that POST /api/toasts/check may use (default 0.2).
T2F_AI_TOASTS_SPEND_SHARE=
# Share of each provider's RPM above reserved for POST /api/toasts/check, in (0, 1) (default 0.2); the rest is for chat, nicks and translation.
T2F_AI_TOASTS_RPM_SHARE=
