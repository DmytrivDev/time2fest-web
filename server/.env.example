# Names only, no values. `pnpm db:create` writes server/.env.local (gitignored).
T2F_ENV=
T2F_TEST_DOORS=
T2F_SLOT=
T2F_SLUG=
T2F_SERVER_PORT=
T2F_HOST=
T2F_COMMIT=
T2F_WEB_PORT=
T2F_LOCK_DIR=
T2F_ALLOWED_ORIGINS=
DATABASE_URI=
REDIS_URL=
T2F_REDIS_PREFIX=
T2F_CENTRIFUGO_URL=
T2F_CENTRIFUGO_PREFIX=
SMTP_HOST=
SMTP_PORT=
PAYLOAD_SECRET=
PAYPRO_MODE=
T2F_EDGE_SECRET=
T2F_EDGE_SECRET_PREVIOUS=
T2F_CENTRIFUGO_TOKEN_SECRET=
T2F_CENTRIFUGO_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
T2F_AI_ANTHROPIC_URL=
T2F_AI_ANTHROPIC_MODEL=
T2F_AI_ANTHROPIC_VERSION=
T2F_AI_ANTHROPIC_PRICE_INPUT=
T2F_AI_ANTHROPIC_PRICE_OUTPUT=
T2F_AI_ANTHROPIC_PRICE_CACHE_READ=
T2F_AI_ANTHROPIC_PRICE_CACHE_WRITE=
T2F_AI_DEEPSEEK_URL=
T2F_AI_DEEPSEEK_MODEL=
T2F_AI_DEEPSEEK_PRICE_CACHE_HIT=
T2F_AI_DEEPSEEK_PRICE_CACHE_MISS=
T2F_AI_DEEPSEEK_PRICE_OUTPUT=
# User AI calls a minute per provider for the whole account (defaults 3400 / 1000); each server process uses floor(budget / T2F_AI_PROCESSES).
T2F_AI_ANTHROPIC_RPM=
T2F_AI_DEEPSEEK_RPM=
# Number of server processes sharing the AI accounts, positive integer (default 1).
T2F_AI_PROCESSES=
# Share of each AI spend ceiling that POST /api/toasts/check may use (default 0.2).
T2F_AI_TOASTS_SPEND_SHARE=
# Share of each provider's RPM above reserved for POST /api/toasts/check, in (0, 1) (default 0.2); the rest is for chat, nicks and translation.
T2F_AI_TOASTS_RPM_SHARE=
# SPEC-08: edge purge after a site change (all optional; absent: purge skipped with a log line).
T2F_CF_PURGE_TOKEN=
T2F_CF_ZONE_ID=
T2F_SITE_URL=
# SPEC-08: catalog rebuild launch (workflow_dispatch of deploy.yml); production launches only with T2F_REBUILD_PRODUCTION=1 (default 0).
T2F_GITHUB_DISPATCH_TOKEN=
T2F_REBUILD_PRODUCTION=
# SPEC-12: live air. The poller starts only with T2F_YOUTUBE_BASE_URL; the key is optional. T2F_LIVE_CONFIG is partial JSON over the live defaults.
T2F_YOUTUBE_API_KEY=
T2F_YOUTUBE_BASE_URL=
T2F_LIVE_CONFIG=
# SPEC-13b: Telegram alarms (all optional outside production; absent: the sink is off with one log line).
# In test T2F_TELEGRAM_API_BASE must be loopback (the fake), otherwise the sink stays off.
T2F_TELEGRAM_API_BASE=
T2F_TELEGRAM_BOT_TOKEN=
T2F_TELEGRAM_CHAT_ID=
T2F_TELEGRAM_TEST_CHAT_ID=
# SPEC-13b: backup encryption key, base64 of 32 bytes (absent: the backup does not start; required in production).
T2F_BACKUP_KEY=
