# Лише імена; значення — у .local/вузлі. T2F_ENV, T2F_HOST, T2F_SERVER_PORT задає
# compose, T2F_COMMIT запечено в образ — їх тут немає навмисно.
# Не секретні типові значення репетиції вже вписані; решту заповнює
# `edge-secret --generate` (DATABASE_URI, REDIS_URL, T2F_REDIS_PREFIX,
# PAYLOAD_SECRET, T2F_EDGE_SECRET) або власник вручну.
DATABASE_URI=
REDIS_URL=
T2F_REDIS_PREFIX=
PAYLOAD_SECRET=
T2F_EDGE_SECRET=
# Порожнє = не задано; на час заміни секрету краю сюди кладуть попереднє значення.
T2F_EDGE_SECRET_PREVIOUS=
T2F_ACCESS_AUD=
T2F_ACCESS_JWKS_URL=https://time2fest.cloudflareaccess.com/cdn-cgi/access/certs
T2F_ACCESS_TEAM_DOMAIN=https://time2fest.cloudflareaccess.com
T2F_ADMIN_HOST=admin-rehearsal.time2fest.com
T2F_OWNER_EMAILS=
T2F_R2_ACCESS_KEY_ID=
T2F_R2_SECRET_ACCESS_KEY=
T2F_R2_BUCKET=time2fest-rehearsal
T2F_R2_ENDPOINT=
T2F_R2_PREFIX=
# Realtime (SPEC-06): сервер у rehearsal і production не стартує без цих трьох.
# URL — внутрішній порт API Centrifugo на вузлі; обидва секрети ≥32 символи й різні.
# Поки Centrifugo на вузлі немає, розгортання цього коміту впаде на перевірці змінних.
T2F_CENTRIFUGO_URL=
T2F_CENTRIFUGO_TOKEN_SECRET=
T2F_CENTRIFUGO_API_KEY=
# Вхід (SPEC-10): T2F_AUTH_SECRET ≥32 символи, без нього сервер у rehearsal і production не стартує.
# Google вимкнено, поки T2F_GOOGLE_DISCOVERY_URL порожній (лише https). Кінець сезону — типово 2027-01-15T00:00:00Z.
T2F_AUTH_SECRET=
T2F_SEASON_END=
T2F_GOOGLE_CLIENT_ID=
T2F_GOOGLE_CLIENT_SECRET=
T2F_GOOGLE_DISCOVERY_URL=
# Пошта (SPEC-10): основний — Resend SMTP, запасний — Cloudflare Email Service. Порожньо = листів немає.
# План T2F_MAIL_PLAN free|pro (типово free); денні стелі типово 100. Перший живий лист — за словом власника.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASSWORD=
SMTP_FALLBACK_DAILY_CEILING=
T2F_MAIL_FROM=
T2F_MAIL_PLAN=
T2F_MAIL_DAILY_CEILING=
# Лише в production:
T2F_ALLOWED_ORIGINS=
PAYPRO_MODE=sandbox
# Операції (SPEC-13b). Telegram: на репетиції — лише тестовий канал (T2F_TELEGRAM_TEST_CHAT_ID),
# чат власника там ігнорується; порожньо = тривоги лише в журнал. Перше живе повідомлення — за словом власника.
T2F_TELEGRAM_API_BASE=
T2F_TELEGRAM_BOT_TOKEN=
T2F_TELEGRAM_CHAT_ID=
T2F_TELEGRAM_TEST_CHAT_ID=
# Ключ шифрування копій бази: base64 від 32 байтів; порожньо = копія не стартує. У production обов’язковий.
T2F_BACKUP_KEY=
