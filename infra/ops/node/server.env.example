# Лише імена; значення — у .local/вузлі. T2F_ENV, T2F_HOST, T2F_SERVER_PORT задає
# compose, T2F_COMMIT запечено в образ — їх тут немає навмисно.
# Не секретні типові значення репетиції вже вписані; решту заповнює
# `edge-secret --generate` (DATABASE_URI, REDIS_URL, T2F_REDIS_PREFIX,
# PAYLOAD_SECRET, T2F_EDGE_SECRET) або власник вручну.
DATABASE_URI=
REDIS_URL=
T2F_REDIS_PREFIX=
PAYLOAD_SECRET=
T2F_EDGE_SECRET=
# Порожнє = не задано; на час заміни секрету краю сюди кладуть попереднє значення.
T2F_EDGE_SECRET_PREVIOUS=
T2F_ACCESS_AUD=
T2F_ACCESS_JWKS_URL=https://time2fest.cloudflareaccess.com/cdn-cgi/access/certs
T2F_ACCESS_TEAM_DOMAIN=https://time2fest.cloudflareaccess.com
T2F_ADMIN_HOST=admin-rehearsal.time2fest.com
T2F_OWNER_EMAILS=
T2F_R2_ACCESS_KEY_ID=
T2F_R2_SECRET_ACCESS_KEY=
T2F_R2_BUCKET=time2fest-rehearsal
T2F_R2_ENDPOINT=
T2F_R2_PREFIX=
# Лише в production:
T2F_ALLOWED_ORIGINS=
PAYPRO_MODE=sandbox
