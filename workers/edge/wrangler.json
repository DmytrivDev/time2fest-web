{
  "name": "t2f-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api", "/api/*"]
  },
  "env": {
    "test": {
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "../../out-edge-test",
        "binding": "ASSETS",
        "html_handling": "force-trailing-slash",
        "not_found_handling": "none",
        "run_worker_first": ["/api", "/api/*"]
      },
      "routes": [{ "pattern": "test.time2fest.com", "custom_domain": true }],
      "vars": { "EDGE_ENV": "test", "ORIGIN_URL": "https://o-test.time2fest.com" }
    },
    "rehearsal": {
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "../../out-edge-rehearsal",
        "binding": "ASSETS",
        "html_handling": "force-trailing-slash",
        "not_found_handling": "none",
        "run_worker_first": ["/api", "/api/*"]
      },
      "routes": [{ "pattern": "rehearsal.time2fest.com", "custom_domain": true }],
      "vars": { "EDGE_ENV": "rehearsal", "ORIGIN_URL": "https://o-rehearsal.time2fest.com" }
    },
    "prelaunch": {
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "../../out-prelaunch",
        "binding": "ASSETS",
        "html_handling": "force-trailing-slash",
        "not_found_handling": "none",
        "run_worker_first": ["/api", "/api/*"]
      },
      "routes": [{ "pattern": "time2fest.com", "custom_domain": true }],
      "vars": { "EDGE_ENV": "prelaunch" }
    },
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "../../out",
        "binding": "ASSETS",
        "html_handling": "force-trailing-slash",
        "not_found_handling": "none",
        "run_worker_first": ["/api", "/api/*"]
      },
      "routes": [{ "pattern": "time2fest.com", "custom_domain": true }],
      "vars": { "EDGE_ENV": "production", "ORIGIN_URL": "https://o.time2fest.com" }
    }
  }
}
